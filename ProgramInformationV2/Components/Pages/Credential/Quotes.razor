@page "/credential/quote"
@layout SidebarLayout

<PageTitle>Credential Quote Information | Illinois</PageTitle>

<ilw-content>
    <h1>Quote Information</h1>
</ilw-content>

@if (CredentialItem != null && FieldItems != null) {
    <MediumText Title="Quote Title" FieldItems="FieldItems" @bind-Value="CredentialItem.StudentQuoteTitle"></MediumText>
    <MediumText Title="Quote Subtitle" FieldItems="FieldItems" @bind-Value="CredentialItem.Fragment"></MediumText>
    <LargeText Title="Quote" FieldItems="FieldItems" @bind-Value="CredentialItem.StudentQuoteText"></LargeText>

    <div class="image-box">
        <ImageControl @ref="@_imageUrl" Title="Quote Image" FieldItems="FieldItems" @bind-Value="CredentialItem.StudentQuoteImageUrl" ItemId="@CredentialItem.Id"></ImageControl>
        <MediumText Title="Quote Image Alternative Text" FieldItems="FieldItems" @bind-Value="CredentialItem.StudentQuoteImageAltText"></MediumText>
    </div>
    <ul class="ilw-buttons" id="save-group">
        <li>
            <button class="ilw-button ilw-theme-orange-solid" @onclick="Save" @onblur="Layout.RemoveMessage">Save</button>
        </li>
        <li>
            <ViewLink Title="Credential" Url="@CredentialItem.UrlFull"></ViewLink>
        </li>
        @if (UsePrograms) {
            <li>
                <a class="ilw-button" @onclick="BackToProgram">Back</a>
            </li>
        }
    </ul>
    <NothingDisplayed Screen="Data.DataModels.FieldType.QuoteOption" FieldItems="FieldItems"></NothingDisplayed>
}