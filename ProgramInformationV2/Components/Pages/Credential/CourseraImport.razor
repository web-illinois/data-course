@page "/credentials/courseraimport"
@layout SidebarLayout

<PageTitle>Import a Coursera Specialization | Illinois</PageTitle>
<ilw-content>
    <h1>Import a Coursera Specialization</h1>
    @if (_useCourses.HasValue && _useCourses.Value) {
        <p>Note that this will overwrite any changes you made to the existing item.</p>
        <div class="ils-input-entry">
            <label for="search">Search Term</label>
            <input id="search" type="text" @bind="SearchTerm" class="ils-input-long" />
        </div>
        <button class="ilw-button" @onclick="Search">Search for Specializations</button>
        @if (ListOfCourseraSpecialties != null && ListOfCourseraSpecialtiesSelected != null) {
            <div class="container-coursera">
                <div class="ils-input-entry">
                    <label for="options">Coursera Specialties</label>
                    <select id="options" type="text" @bind="ListOfCourseraSpecialtyId" size="10" style="width: 100%;">
                        @foreach (var course in ListOfCourseraSpecialties) {
                            <option value="@course.Key">@course.Value</option>
                        }
                    </select>
                    <div style="display: flex;">
                        <button class="ilw-button" @onclick="Transfer">Add To Selected List</button>
                        <button class="ilw-button" @onclick="TransferAll">Add All</button>
                    </div>
                </div>
            </div>
            <div class="container-coursera">
                <div class="ils-input-entry">
                    <label for="optionsselected">Selected Specializations</label>
                    <select id="optionsselected" type="text" @bind="ListOfCourseraSpecialtyIdSelected" size="10" style="width: 100%;">
                        @foreach (var course in ListOfCourseraSpecialtiesSelected) {
                            <option value="@course.Key">@course.Value</option>
                        }
                    </select>
                    <div style="display: flex;">
                        <button class="ilw-button" @onclick="Remove">Remove From Selected List</button>
                        <button class="ilw-button" @onclick="RemoveAll">Remove All</button>
                    </div>
                </div>
            </div>
            <button class="ilw-button ilw-theme-orange-solid" @onclick="SendImport" @onblur="Layout.RemoveMessage">Import Specialization</button>
        }
    }
</ilw-content>