@page "/credential/overview"
@layout SidebarLayout

<PageTitle>Credential Overview | Illinois</PageTitle>

<ilw-content>
    <h1>Overview</h1>
    <RichTextEditor @ref="@_rteDescription" Title="Description" FieldItems="FieldItems"></RichTextEditor>
    <MediumText Title="Program Notes Title" FieldItems="FieldItems" @bind-Value="CredentialItem.NoteTitle"></MediumText>
    <RichTextEditor @ref="@_rteProgramNotes" Title="Program Notes" FieldItems="FieldItems"></RichTextEditor>
    <RichTextEditor @ref="@_rteWhoShouldApply" Title="Who Should Apply" FieldItems="FieldItems"></RichTextEditor>
    <RichTextEditor @ref="@_rteJobTypeInformation" Title="Job Type Information" FieldItems="FieldItems"></RichTextEditor>
    <RichTextEditor @ref="@_rteProfessionalInformation" Title="Professional Information" FieldItems="FieldItems"></RichTextEditor>
    <RichTextEditor @ref="@_rteSkills" Title="Skills" FieldItems="FieldItems"></RichTextEditor>
    @if (CredentialItem != null && FieldItems != null) {
        <ul class="ilw-buttons" id="save-group">
            <li>
                <button class="ilw-button ilw-theme-orange-solid" @onclick="Save" @onblur="Layout.RemoveMessage">Save</button>
            </li>
            <li>
                <ViewLink Title="Credential" Url="@CredentialItem.UrlFull"></ViewLink>
            </li>
            @if (UsePrograms)
            {
                <li>
                    <a class="ilw-button" @onclick="BackToProgram">Back</a>
                </li>
            }
        </ul>
    }
    <NothingDisplayed Screen="Data.DataModels.FieldType.Overview" FieldItems="FieldItems"></NothingDisplayed>
</ilw-content>