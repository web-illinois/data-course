@page "/credential/general"
@layout SidebarLayout

<PageTitle>Credential General Information | Illinois</PageTitle>

<ilw-content>
    <h1>General Information</h1>
</ilw-content>

@if (CredentialItem != null && FieldItems != null) {
    <MediumText Title="Title" FieldItems="FieldItems" @bind-Value="CredentialItem.Title"></MediumText>
    <MediumText Title="Summary Title" FieldItems="FieldItems" @bind-Value="CredentialItem.SummaryTitle"></MediumText>
    <LargeText Title="Summary Text" FieldItems="FieldItems" @bind-Value="CredentialItem.SummaryText"></LargeText>
    <MediumText Title="Contact" FieldItems="FieldItems" @bind-Value="CredentialItem.ContactName"></MediumText>
    <MediumText Title="Contact Email" FieldItems="FieldItems" @bind-Value="CredentialItem.ContactEmail"></MediumText>
    <MediumText Title="Credit Hours" FieldItems="FieldItems" @bind-Value="CredentialItem.HourText"></MediumText>
    <MediumText Title="Cost" FieldItems="FieldItems" @bind-Value="CredentialItem.Cost"></MediumText>
    <MediumText Title="Online Cost" FieldItems="FieldItems" @bind-Value="CredentialItem.CostOnline"></MediumText>
    <MediumText Title="Credential Length" FieldItems="FieldItems" @bind-Value="CredentialItem.Length"></MediumText>
    <MediumText Title="Online Credential Length" FieldItems="FieldItems" @bind-Value="CredentialItem.LengthOnline"></MediumText>
    <MediumText Title="Suggested Enrollment Date" FieldItems="FieldItems" @bind-Value="CredentialItem.Enrollment"></MediumText>
    <MediumText Title="Online Suggested Enrollment Date" FieldItems="FieldItems" @bind-Value="CredentialItem.EnrollmentOnline"></MediumText>
    <MediumText Title="Online Suggested Enrollment Date Fall" FieldItems="FieldItems" @bind-Value="CredentialItem.EnrollmentOnlineFall"></MediumText>
    <MediumText Title="Online Suggested Enrollment Date Spring" FieldItems="FieldItems" @bind-Value="CredentialItem.EnrollmentOnlineSpring"></MediumText>
    <MediumText Title="Online Suggested Enrollment Date Summer" FieldItems="FieldItems" @bind-Value="CredentialItem.EnrollmentOnlineSummer"></MediumText>
    <SelectList Title="Credential Type" FieldItems="FieldItems" @bind-Value="CredentialItem.CredentialType"></SelectList>
    <CheckboxList Title="Course Format" FieldItems="FieldItems" @bind-Value="CredentialItem.FormatType"></CheckboxList>
    <ul class="ilw-buttons" id="save-group">
        <li>
            <button class="ilw-button ilw-theme-orange-solid" @onclick="Save" @onblur="Layout.RemoveMessage">Save</button>
        </li>
        <li>
            <ViewLink Title="Credential" Url="@CredentialItem.UrlFull"></ViewLink>
        </li>
        @if (UsePrograms)
        {
            <li>
                <a class="ilw-button" @onclick="BackToProgram">Back</a>
            </li>
        }
    </ul>
    <NothingDisplayed Screen="Data.DataModels.FieldType.General" FieldItems="FieldItems"></NothingDisplayed>
}

